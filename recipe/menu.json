{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-0.schema.json",
  "menu_name": "Spotifast",
  "menu_items": [
    {
      "name": "Spotifast",
      "description": "A fast, native Spotify client",
      "icon": "{{ MENU_DIR }}/spotifast.{{ ICON_EXT }}",
      "command": ["{{ BIN_DIR }}/spotifast"],
      "platforms": {
        "linux": {
          "StartupNotify": true,
          "Categories": ["AudioVideo", "Audio", "Player", "Music"],
          "GenericName": "Music Player",
          "StartupWMClass": "spotifast",
          "MimeType": ["x-scheme-handler/spotify"]
        },
        "osx": {
          "CFBundleIdentifier": "rocks.spotifast.Spotifast",
          "CFBundleVersion": "__PKG_VERSION__",
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "Spotify links",
              "CFBundleURLSchemes": ["spotify"]
            }
          ]
        },
        "win": {
          "command": ["{{ BIN_DIR }}/spotifast.exe"],
          "url_protocols": ["spotify"]
        }
      }
    }
  ]
}
